# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=techexpert
POSTGRES_PASSWORD=techexpert
POSTGRES_DB=techexpert
DATABASE_URL=postgresql://techexpert:techexpert@localhost:5432/techexpert

# Caminho da Base de Conhecimento SWI-Prolog
PROLOG_KB_PATH=prolog/knowledge_base.pl

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Chave administrativa para gestão da base de conhecimento (RF08)
ADMIN_API_KEY=change-me-admin-key

